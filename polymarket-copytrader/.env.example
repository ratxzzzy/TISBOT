# ============================================
# Polymarket Copytrader Bot v2.0 - Configuration
# ============================================

# RPC - Polygon Network (Alchemy or Infura)
POLYGON_RPC_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_HTTP_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Wallet - EOA private key (owner of the Gnosis Safe, WITHOUT 0x prefix)
PRIVATE_KEY=your_private_key_here

# Gnosis Safe - Safe holds the funds, EOA signs transactions on its behalf
SAFE_ADDRESS=0xc686C94F4CEa13e3df463F1Fd93baA55A4fa63b6
EOA_ADDRESS=0x5402a6266e747483feb65C6e759bbA09f5F4C175

# Polymarket CLOB API
POLYMARKET_API_URL=https://clob.polymarket.com

# Copytrading - Wallet to copy
WALLET_TO_COPY=0x03c3b0236c5a01051381482e77f2210349073a1d

# ============================================
# Position Sizing
# ============================================
# Percentage of the trader's amount to copy (flat %)
# Example: 10 means we copy 10% of whatever the trader trades
COPY_PERCENTAGE=10

# Minimum position size - trades below this are skipped
MIN_POSITION_SIZE_USDC=0.50

# Trading Parameters
SLIPPAGE_TOLERANCE=2

# Optional - Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
